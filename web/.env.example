# Copy to .env to change. Defaults work with `python api/run.py` + `npm run dev`.

# true = run fully in the browser against the mock server (no backend needed)
VITE_USE_MOCKS=false
# Where `npm run dev` / `npm run preview` forward /api requests
VITE_API_PROXY=http://127.0.0.1:8080
# Only for a frontend hosted on a different origin than the API (leave empty to use the proxy / same origin)
VITE_API_BASE=
